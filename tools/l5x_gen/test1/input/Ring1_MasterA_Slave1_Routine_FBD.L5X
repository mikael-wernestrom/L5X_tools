<DataValueMember Name="Cfg_HiOnDly" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Cfg_HiOffDly" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Cfg_HiGateDly" DataType="REAL" Radix="Float" Value="0.0"/>
