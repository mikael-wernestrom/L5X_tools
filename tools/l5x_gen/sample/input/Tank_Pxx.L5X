<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="32.00"
    TargetName="{{ tag_prefix }}_Controller" TargetType="Controller">

  <Controller Name="{{ tag_prefix }}_Controller" ProcessorType="1756-L85E">
    <Description>{{ tank_descr }}</Description>

    <Tags>
      <Tag Name="{{ tag_prefix }}_Level" TagType="Base" DataType="REAL">
        <Description>Tank {{ tag_prefix }} level measurement</Description>
      </Tag>
{% for valve in valves %}
      <Tag Name="{{ tag_prefix }}_{{ valve.tag }}" TagType="Base" DataType="BOOL">
        <Description>{{ valve.description }} ({{ valve.size }}, {{ valve.type }})</Description>
      </Tag>
{% endfor %}
{% if has_agitator %}
      <Tag Name="{{ tag_prefix }}_AgitatorRun" TagType="Base" DataType="BOOL">
        <Description>Tank {{ tag_prefix }} agitator run command</Description>
      </Tag>
      <Tag Name="{{ tag_prefix }}_AgitatorSpeed" TagType="Base" DataType="REAL">
        <Description>Tank {{ tag_prefix }} agitator speed setpoint (RPM)</Description>
      </Tag>
{% endif %}
{% if motors is defined %}
{% for motor in motors %}
      <Tag Name="{{ tag_prefix }}_{{ motor.tag }}_Run" TagType="Base" DataType="BOOL">
        <Description>{{ motor.description }} ({{ motor.kw }}kW) run command</Description>
      </Tag>
{% endfor %}
{% endif %}
    </Tags>

  </Controller>
</RSLogix5000Content>
